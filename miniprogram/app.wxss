page {
  min-height: 100%;
  background: #faf4ea;
  color: #4f3a2d;
  font-size: var(--font-28, 28rpx);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
input,
textarea,
button,
picker,
switch,
slider,
canvas,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.4;
  background: transparent;
  border-radius: 0;
}
button::after { border: none; }

.page-shell {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  padding: 22rpx 28rpx calc(156rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fffaf2;
  border: 2rpx solid #efd6b5;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(105, 76, 52, .055);
}

.section-title {
  color: #3f3028;
  font-size: var(--font-31, 31rpx);
  font-weight: 900;
  line-height: 1.35;
}
.section-desc,
.muted { color: #918178; }
.eyebrow {
  color: #9a8069;
  font-size: var(--font-18, 18rpx);
  font-weight: 900;
  letter-spacing: 2rpx;
}

.primary-button,
.secondary-button,
.soft-button,
.danger-button {
  min-height: 70rpx;
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
  font-size: var(--font-23, 23rpx);
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.primary-button { color: #fffdf8; background: #6c9a61; }
.secondary-button { color: #59483d; background: #f3ebe0; }
.soft-button { color: #7a6250; background: #fff7e9; border: 1rpx solid #ead8bd; }
.danger-button { color: #a44e37; background: #fbe9e2; }
.inline-button { color: #7f6b5b; font-size: var(--font-22, 22rpx); font-weight: 800; }

.input-shell {
  min-height: 72rpx;
  padding: 14rpx 18rpx;
  background: #fffdf8;
  border: 2rpx solid #ead8bd;
  border-radius: 16rpx;
  color: #4a3b32;
  font-size: var(--font-25, 25rpx);
}
.safe-bottom { height: calc(24rpx + env(safe-area-inset-bottom)); }

@media (max-width: 360px) {
  .page-shell { padding-left: 22rpx; padding-right: 22rpx; }
  .card { border-radius: 22rpx; }
}


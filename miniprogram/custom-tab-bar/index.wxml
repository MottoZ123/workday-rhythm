<view class="tab-shell font-{{fontMode}}">
  <view class="tab-panel">
    <view wx:for="{{list}}" wx:key="pagePath" class="tab-item {{selected === index ? 'tab-active' : ''}}" data-index="{{index}}" bindtap="switchTab">
      <view class="icon-wrap {{selected === index ? 'icon-active' : ''}}">
        <image class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>

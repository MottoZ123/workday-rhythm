.report-page { min-height: 100vh; background: radial-gradient(circle at 88% 4%, rgba(241,169,95,.16), transparent 30%), #f8f1e5; }
.report-preview { padding: 28rpx; background: linear-gradient(150deg, #fffdf7, #fff7e8); }
.report-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.report-title { margin-top: 8rpx; color: #3e2c24; font-size: var(--font-43, 43rpx); font-weight: 900; }
.report-date { margin-top: 7rpx; color: #998a7d; font-size: var(--font-20, 20rpx); }
.report-stamp { flex: 0 0 auto; width: 74rpx; height: 74rpx; border-radius: 24rpx; color: #fff; background: #ef9b4d; display: flex; align-items: center; justify-content: center; font-size: var(--font-26, 26rpx); font-weight: 900; transform: rotate(6deg); }
.metric-row { display: flex; gap: 14rpx; margin-top: 24rpx; }
.metric-block { flex: 1; min-width: 0; padding: 20rpx; border: 2rpx solid #ecd7b6; border-radius: 20rpx; background: rgba(255,255,255,.74); }
.metric-label { color: #7e6b5b; font-size: var(--font-20, 20rpx); font-weight: 800; }
.metric-value { margin-top: 10rpx; color: #4a3b32; font-size: var(--font-32, 32rpx); font-weight: 900; line-height: 1.3; word-break: break-word; }
.metric-note { margin-top: 6rpx; color: #9a8b7f; font-size: var(--font-18, 18rpx); line-height: 1.4; }
.money-panel { margin-top: 16rpx; padding: 22rpx; border-radius: 22rpx; background: #eaf3e7; }
.money-label { color: #5d7b6f; font-size: var(--font-20, 20rpx); font-weight: 900; }
.money-value { margin-top: 10rpx; color: #3f5e48; font-size: var(--font-50, 50rpx); font-weight: 900; }
.money-note { margin-top: 5rpx; color: #8b765f; font-size: var(--font-19, 19rpx); }
.quote-panel { margin-top: 16rpx; padding: 22rpx; border-radius: 22rpx; background: #fff0cf; }
.quote-label { color: #9a6d3f; font-size: var(--font-18, 18rpx); font-weight: 900; }
.quote-text { margin-top: 9rpx; color: #6e5338; font-size: var(--font-22, 22rpx); line-height: 1.65; }
.report-footer { margin-top: 20rpx; color: #a09387; font-size: var(--font-17, 17rpx); text-align: center; }
.action-row { display: flex; gap: 12rpx; margin-top: 18rpx; }
.action-button { flex: 1; min-width: 0; min-height: 76rpx; border-radius: 18rpx; font-size: var(--font-23, 23rpx); font-weight: 900; display: flex; align-items: center; justify-content: center; }
.save-image { color: #fff; background: #5d7b6f; }
.copy-text { color: #8f5e32; background: #fff0d6; border: 1rpx solid #edcb98; }
.hint { margin-top: 16rpx; padding: 18rpx 22rpx; color: #8e8074; font-size: var(--font-20, 20rpx); line-height: 1.5; text-align: center; }
.report-canvas { position: fixed; left: -10000px; top: -10000px; width: 650px; height: 880px; }
@media (max-width: 360px) {
  .metric-row { flex-direction: column; }
  .action-row { flex-direction: column; }
}

/* V1.1.1 reference-style overrides */
.report-page { background: #faf4ea; }
.report-preview { padding: 22rpx; background: #fffaf2; }
.report-title { font-size: var(--font-38, 38rpx); }
.metric-row { gap: 10rpx; margin-top: 18rpx; }
.metric-block { padding: 17rpx; border-radius: 17rpx; background: #fffdf8; }
.money-panel { border: 1rpx solid #d7e5d0; background: #edf3df; }
.quote-panel { background: #fff0d6; }
.save-image { background: #6c9a61; }
